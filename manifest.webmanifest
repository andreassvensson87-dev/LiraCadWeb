{
  "id": "/LiraCadWeb/",
  "name": "LiraCAD",
  "short_name": "LiraCAD",
  "lang": "sv",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#17292e",
  "theme_color": "#17292e",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "name": "LiraCAD-ritning",
      "accept": {
        "image/vnd.dwg": [
          ".dwg"
        ],
        "image/vnd.dxf": [
          ".dxf"
        ]
      },
      "launch_type": "single-client"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}
